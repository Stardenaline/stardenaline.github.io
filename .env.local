# Environment Configuration
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=https://starzy.top
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security
INTERNAL_API_KEY=starzy_internal_key_2025_secure_random_string
ASSET_PROTECTION_ENABLED=true

# SSL Configuration
SSL_CERT_PATH=./localhost.pem
SSL_KEY_PATH=./localhost-key.pem
HTTPS_PORT=3001

# External API Domains (for Next.js Image optimization)
NEXT_IMAGE_ALLOWED_DOMAINS=cdn.jsdelivr.net,upload.wikimedia.org,storage.ko-fi.com,storage.sociabuzz.com,starlightskins.lunareclipse.studio,mc-heads.net,textures.minecraft.net

# Performance
NEXT_TELEMETRY_DISABLED=1

# Development
DEBUG=false
